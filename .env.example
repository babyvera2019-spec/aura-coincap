# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Use only the dedicated demo keys (aura-coincap-demo), never AURA's private keys.

# CoinMarketCap API key (https://pro.coinmarketcap.com)
CMC_API_KEY=
CMC_CACHE_SECONDS=300

# Triple AI (leave empty to show the sample run)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Spending limits (USD). A run is refused BEFORE calling any API if it would exceed them.
AI_DAILY_BUDGET_USD=0.30
AI_TOTAL_BUDGET_USD=10
AI_MIN_MINUTES_BETWEEN_RUNS=30
# Coin analyses requested by visitors
AI_COIN_RUNS_PER_DAY=15
AI_COIN_CACHE_MINUTES=60
AI_COIN_RUNS_PER_VISITOR_HOUR=3

# Long random string; needed to trigger POST /api/triple-ai/run
ADMIN_TOKEN=

# Optional: comma-separated RSS feeds
# NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss
